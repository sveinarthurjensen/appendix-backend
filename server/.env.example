# ---- App ----
APP_NAME="Appendix Backend"
# staging | production
APP_ENV=staging
# genereres: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://api-staging.appendixholding.no
# brukes av Caddy for TLS
APP_DOMAIN=api-staging.appendixholding.no
APP_TIMEZONE=Europe/Oslo
APP_LOCALE=nb

LOG_CHANNEL=stack
LOG_LEVEL=info

# ---- Database (PostgreSQL i docker-nettet) ----
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=appendix
DB_USERNAME=appendix
DB_PASSWORD=BYTT_MEG_32_TEGN

# ---- Redis: cache, sesjon, køer ----
REDIS_HOST=redis
REDIS_PASSWORD=BYTT_MEG_32_TEGN
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# ---- Filer (S3-kompatibelt i EU – MinIO lokalt eller Azure Blob) ----
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-north-1
AWS_BUCKET=appendix-files
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# ---- E-post (husk: Exchange legger på signatur selv) ----
MAIL_MAILER=smtp
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@appendixholding.no
MAIL_FROM_NAME="${APP_NAME}"

# ---- Eksterne integrasjoner (fylles ved migrering av funksjonene) ----
SIGNICAT_CLIENT_ID=
SIGNICAT_CLIENT_SECRET=
AZURE_FHIR_URL=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
STRIPE_KEY=
STRIPE_SECRET=
SMS_API_KEY=
SCHEDULER_ENABLED=false
CORS_ALLOWED_ORIGINS=https://aprop.no,https://www.aprop.no
